{
    "name": "wajub/wajub-php",
    "description": "Official Wajub PHP SDK — server-side payments, and merchant API",
    "type": "library",
    "version": "1.1.0",
    "license": "MIT",
    "keywords": ["wajub", "payments", "webhooks", "mobile-money", "africa", "checkout"],
    "homepage": "https://docs.wajub.com/libraries/sdks/php",
    "authors": [
        {
            "name": "Wajub",
            "homepage": "https://wajub.com"
        }
    ],
    "support": {
        "issues": "https://github.com/wajub/wajub-php/issues",
        "source": "https://github.com/wajub/wajub-php"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.9",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Wajub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wajub\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "prefer-stable": true,
    "minimum-stability": "stable"
}
