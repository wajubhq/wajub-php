{
  "name": "wajub/wajub-php",
  "description": "Official Wajub PHP SDK server-side payments, and merchant API",
  "keywords": [
    "wajub",
    "payments",
    "webhooks",
    "mobile-money",
    "africa",
    "checkout"
  ],
  "homepage": "https://docs.wajub.com/libraries/sdks/php",
  "license": "MIT",
  "authors": [
    {
      "name": "Wajub",
      "homepage": "https://wajub.com"
    }
  ],
  "support": {
    "issues": "https://github.com/wajubhq/wajub-php/issues",
    "source": "https://github.com/wajubhq/wajub-php",
    "docs": "https://docs.wajub.com/libraries/sdks/php"
  },
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "laravel/pint": "^1.25",
    "pestphp/pest": "^5.0",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Wajub\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wajub\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint",
    "refactor": "vendor/bin/rector process",
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
